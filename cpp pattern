#include <iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int nst=1, nsp=n-1;//starting value hai ye ki start khn se ho rha hai
    for(int i=1;i<=n;i++){
        for(int j=1;j<=nsp;j++){
            cout<<" ";
        }
        for(int j=1;j<=nst;j++){
            cout<<"* ";
        }
        nsp--;
        nst +=2;
        cout<<endl;//upper pryamid ho gya
    }
    int nspa=1,nsta=2*n-3;
    for(int i=1;i<=n-1;i++){
        for(int j=1;j<=nspa;j++){
            cout<<" ";
        }
        for(int j=1;j<=nsta;j++){
            cout<<"* ";
        }
        nspa++;
        nsta -= 2;
        cout<<endl;
    }
}
    
